APP_ENV=local
APP_DEBUG=false

# Leave empty to auto-detect from the script path (recommended for XAMPP).
# Example when the folder name is pwa_based_walkie_talkie:
# APP_BASE_PATH=/pwa_based_walkie_talkie
APP_BASE_PATH=

# Long random string. Never commit a real production secret.
SIGNAL_SECRET=CHANGE_THIS_SECRET

# Maximum users allowed in one channel (2-8 recommended for mesh WebRTC).
SIGNAL_MAX_PEERS=8

# How long one speaker may hold the floor, in milliseconds.
SIGNAL_FLOOR_TIMEOUT_MS=30000

# Maximum raw JSON body size for /signal (bytes).
SIGNAL_MAX_BODY=32768

# Maximum WebRTC payload size inside a signal message (bytes).
SIGNAL_MAX_DATA=12288

# Signed session token lifetime in seconds (default 4 hours).
SIGNAL_TOKEN_TTL=14400

# Remove peers that stop polling after this many seconds.
SIGNAL_PEER_STALE_SECONDS=20
